{
  "$description": "DEPRECATED. The hand-authored tokens that predate the Figma export, kept only so components keep rendering while they are remapped onto the tokens generated from variables.json. Their CSS names are emitted verbatim under a `legacy` section of tokens.css. Delete this file once no component references a `--ds-space-*`, `--ds-variant-*` or `--ds-color-*` name.",
  "space": {
    "$type": "dimension",
    "$description": "Named by value: space.6 is 6px.",
    "0": { "$value": "0px" },
    "2": { "$value": "2px" },
    "4": { "$value": "4px" },
    "6": { "$value": "6px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "14": { "$value": "14px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "40": { "$value": "40px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" },
    "80": { "$value": "80px" }
  },
  "variant": {
    "$type": "color",
    "$description": "Background and text pairs supplied by design, one per variant. These drive the solid type.",
    "black": {
      "background": { "$value": "#000000" },
      "text": { "$value": "#e6e6e6" }
    },
    "white": {
      "background": { "$value": "#ffffff" },
      "text": { "$value": "#2b2b2b" }
    },
    "coal": {
      "background": { "$value": "#64739b" },
      "text": { "$value": "#f2f2f2" }
    },
    "dlvRed": {
      "background": { "$value": "#ed1b36" },
      "text": { "$value": "#f2f2f2" }
    },
    "info": {
      "background": { "$value": "#2396fb" },
      "text": { "$value": "#f2f2f2" }
    },
    "success": {
      "background": { "$value": "#1ba86e" },
      "text": { "$value": "#f2f2f2" }
    },
    "warning": {
      "background": { "$value": "#f5c828" },
      "text": { "$value": "#7b6414" }
    },
    "error": {
      "background": { "$value": "#dc143c" },
      "text": { "$value": "#f2f2f2" }
    },
    "cardbox": {
      "background": { "$value": "#b88b5c" },
      "text": { "$value": "#e6e6e6" }
    }
  },
  "statusDot": {
    "$type": "color",
    "$description": "Presence indicator.",
    "color": { "$value": "#1ba86e" }
  },
  "color": {
    "$type": "color",
    "black": { "$value": "#101828" },
    "white": { "$value": "#ffffff" },
    "grey-50": { "$value": "#f9fafb" },
    "grey-100": { "$value": "#f2f4f7" },
    "grey-200": { "$value": "#e4e7ec" },
    "grey-300": { "$value": "#d0d5dd" },
    "grey-400": { "$value": "#98a2b3" },
    "grey-500": { "$value": "#667085" },
    "grey-600": { "$value": "#475467" },
    "coal-50": { "$value": "#eef1f8" },
    "coal-200": { "$value": "#c6cde3" },
    "coal-700": { "$value": "#3a4462" },
    "dlv-red-50": { "$value": "#fdebec" },
    "dlv-red-200": { "$value": "#f7c2c5" },
    "dlv-red-500": { "$value": "#e1252c" },
    "dlv-red-700": { "$value": "#9e161c" },
    "info-50": { "$value": "#eaf4fd" },
    "info-200": { "$value": "#bcdcf8" },
    "info-500": { "$value": "#1a7fd4" },
    "info-700": { "$value": "#10507f" },
    "success-50": { "$value": "#e7f6ef" },
    "success-200": { "$value": "#b3e3cd" },
    "success-500": { "$value": "#0f8a5f" },
    "success-700": { "$value": "#08543a" },
    "warning-50": { "$value": "#fdf5e0" },
    "warning-200": { "$value": "#f8e3a8" },
    "warning-700": { "$value": "#8a6d00" },
    "error-50": { "$value": "#fdeaef" },
    "error-200": { "$value": "#f8bfd0" },
    "error-700": { "$value": "#85103b" },
    "cardbox-50": { "$value": "#f7f0e6" },
    "cardbox-200": { "$value": "#e5d0b0" },
    "cardbox-700": { "$value": "#6b4f2d" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "'Noto Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
    },
    "weight": {
      "$type": "fontWeight",
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "3px" },
    "md": { "$value": "4px" },
    "full": { "$value": "999px" }
  },
  "border": {
    "$type": "dimension",
    "width": { "$value": "1px" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": "cubic-bezier(0.2, 0, 0.2, 1)" }
  }
}
